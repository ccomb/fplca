cabal-version:       2.4
name:                volca
version:             0.6.1.0
build-type:          Simple

license:             Apache-2.0
license-file:        LICENSE
author:              Christophe Combelles
maintainer:          ccomb@free.fr
category:            Life Cycle Assessment
synopsis:            In-memory high performance LCA engine
description:         This project is a Life Cycle Assessment (LCA) engine.

extra-source-files:  README.md CHANGELOG.md

common warnings
  ghc-options:         -Wall -O2

common rtsdefaults
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N

library
  import:              warnings
  hs-source-dirs:      src
  exposed-modules:     Types
                     , App.Env
                     , Data.Validation
                     , Progress
                     , UnitConversion
                     , Config
                     , ConfigWriter
                     , Service
                     , Service.Aggregate
                     , Tree
                     , Matrix
                     , Matrix.Export
                     , SharedSolver
                     , Database
                     , Database.Manager
                     , Database.Loader
                     , Database.CrossLinking
                     , Database.MatrixBuild
                     , Database.Upload
                     , Database.UploadedDatabase
                     , SynonymDB
                     , SynonymDB.Types
                     , SynonymDB.Extract
                     , Method.Types
                     , Method.CSV
                     , Method.Parser
                     , Method.Parser.OlcaSchema
                     , Method.ParserCSV
                     , Method.ParserSimaPro
                     , Method.ParserNW
                     , Method.Mapping
                     , Method.ChemSynonyms
                     , Method.FlowResolver
                     , API.Routes
                     , API.BatchImpacts
                     , API.Types
                     , API.JsonOptions
                     , API.DatabaseHandlers
                     , API.Auth
                     , API.MCP
                     , API.MCP.Enrich
                     , API.MCP.Columnar
                     , API.OpenApi
                     , API.Resources
                     , API.Licenses
                     , CLI.Types
                     , CLI.Parser
                     , CLI.Command
                     , CLI.Client
                     , CLI.Repl
                     , EcoSpold.Common
                     , EcoSpold.Parser2
                     , EcoSpold.Parser1
                     , SimaPro.Parser
                     , Expr
                     , ILCD.Parser
                     , Plugin.Types
                     , Plugin.Builtin
                     , Plugin.Bridge
                     , Plugin.Config
                     , Search.Normalize
                     , Search.BM25
                     , Search.BM25.Types
                     , Search.Fuzzy
                     , Version
  build-depends:       base >=4.14 && <5
                     , optparse-applicative
                     , text
                     , containers
                     , xeno
                     , filepath
                     , directory
                     , mtl
                     , bytestring
                     , deepseq
                     , parallel
                     , stm
                     , async
                     , conduit
                     , xml-types
                     , servant-server
                     , servant
                     , servant-multipart
                     , servant-openapi3
                     , openapi3
                     , insert-ordered-containers
                     , lens
                     , warp
                     , aeson
                     , aeson-pretty
                     , scientific
                     , wai
                     , wai-cors
                     , wai-app-static
                     , store
                     , zstd
                     , time
                     , hashable
                     , uuid
                     , http-types
                     , network-uri
                     , streaming-commons
                     , vector
                     , random
                     , mumps-hs
                     , base64-bytestring
                     , toml-reader
                     , filelock
                     , temporary
                     , process
                     , cassava
                     , http-client
                     , haskeline
                     , megaparsec
                     , unicode-transforms
                     , transformers

  default-language:    Haskell2010

executable volca
  import:              warnings, rtsdefaults
  main-is:             Main.hs
  hs-source-dirs:      app
  -- Drop ELF/Mach-O sections nothing references; pairs with cabal.project's
  -- split-sections to actually shrink the linked exe. Apple ld doesn't accept
  -- --gc-sections, uses -dead_strip instead.
  if os(darwin)
    ghc-options:       -optl-Wl,-dead_strip
  else
    ghc-options:       -optl-Wl,--gc-sections
  build-depends:       base >=4.14 && <5
                     , volca
                     , text
                     , containers
                     , bytestring
                     , stm
                     , time
                     , warp
                     , wai
                     , wai-app-static
                     , servant
                     , servant-server
                     , http-types
                     , http-client
                     , optparse-applicative
                     , aeson
                     , directory
                     , filepath

  default-language:    Haskell2010

test-suite lca-tests
  import:              warnings, rtsdefaults
  -- Test code idiomatically destructures well-formed fixtures with partial
  -- patterns; a fixture mismatch should crash the test with the relevant
  -- 'head'/'let Just x' source location rather than be silenced.
  ghc-options:         -Wno-x-partial
                       -Wno-incomplete-uni-patterns
                       -Wno-incomplete-record-updates
                       -Wno-name-shadowing
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  other-modules:       TestHelpers
                     , GoldenData
                     , AutoRelinkSpec
                     , MatrixConstructionSpec
                     , InventorySpec
                     , MatrixExportSpec
                     , MethodSpec
                     , SimaProParserSpec
                     , UnitConversionSpec
                     , PluginSpec
                     , ServerSpec
                     , ILCDParserSpec
                     , SupplyChainSpec
                     , HotspotSpec
                     , TreeSpec
                     , ServiceSpec
                     , CrossLinkingSpec
                     , MinimalCoverSpec
                     , MinimalCoverIntegrationSpec
                     , CrossDBInventorySpec
                     , CrossDBRegionalLCIASpec
                     , CrossDBRegionalLCIAFixture
                     , CrossDBRegionalLCIASubsSpec
                     , CrossDBRegionalLCIASensitivitySpec
                     , RegionalLCIASpec
                     , SharedSolverSpec
                     , CoalescingSolverSpec
                     , FlowResolverSpec
                     , PluginConfigSpec
                     , ConfigSpec
                     , LoaderSpec
                     , MappingSpec
                     , MethodSetTablesSpec
                     , ChemSynonymsSpec
                     , UploadedDatabaseSpec
                     , ProgressSpec
                     , EcoSpold1Spec
                     , EcoSpold2Spec
                     , MCPSchemaSpec
                     , BatchImpactsSpec
                     , MCPEnrichSpec
                     , MCPColumnarSpec
                     , NormalizeSpec
                     , BM25Spec
                     , FuzzySpec
                     , NestedSubstitutionSpec
                     , SubstitutionSpec
                     , SensitivitySpec
                     , CrossDBSubstitutionSpec
                     , DatabaseStatusSpec
                     , DependencyChoiceSpec
                     , OlcaSchemaSpec
                     , LicensesSpec
                     , GeographiesSpec
                     , MethodUploadSpec
                     , AuthSpec
                     , CLISpec
                     , RoutesSpec
                     , NumericEdgesSpec
                     , AggregateSpec
                     , ConfigWriterSpec
                     , PropertiesSpec
  build-depends:       base >=4.14 && <5
                     , volca
                     , hspec
                     , text
                     , containers
                     , vector
                     , bytestring
                     , temporary
                     , time
                     , aeson
                     , stm
                     , http-client
                     , http-types
                     , process
                     , uuid
                     , filepath
                     , directory
                     , async
                     , warp
                     , wai
                     , servant-server
                     , network-uri
                     , base64-bytestring
                     , optparse-applicative
                     , QuickCheck
                     , network
  build-tool-depends:  hspec-discover:hspec-discover

  default-language:    Haskell2010

benchmark volca-bench
  import:              warnings
  type:                exitcode-stdio-1.0
  hs-source-dirs:      bench
  main-is:             Main.hs
  other-modules:       Fixtures
                     , Bench.Json
                     , Bench.Helpers
                     , Bench.Parsers
                     , Bench.Loader
                     , Bench.Solve
                     , Bench.Lcia
  ghc-options:         -threaded -rtsopts "-with-rtsopts=-N -A32m"
  default-extensions:  NumericUnderscores
                     , OverloadedStrings
                     , BangPatterns
  build-depends:       base >=4.14 && <5
                     , volca
                     , aeson
                     , aeson-pretty
                     , async
                     , bytestring
                     , containers
                     , criterion
                     , criterion-measurement
                     , deepseq
                     , directory
                     , filepath
                     , process
                     , random
                     , text
                     , time
                     , uuid
                     , vector
  default-language:    Haskell2010
